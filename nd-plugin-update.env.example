# Copy to e.g. ~/.config/nd-plugin-update.env and point the service at it (see README).

# Required: host path of Navidrome's data folder (the one mounted at /data in the container)
NPU_DATA_DIR=/srv/navidrome/data

# Optional (defaults shown)
#NPU_PLUGINS_DIR=/srv/navidrome/data/plugins
#NPU_BACKUP_DIR=/srv/navidrome/data/plugin-backups
#NPU_KEEP_BACKUPS=3
#NPU_IMAGE=docker.io/deluan/navidrome:latest

# Which plugins to auto-update: * = all, or comma-separated plugin IDs (the .ndp filename without .ndp)
#NPU_PLUGINS=*
# Plugins never to auto-update. They're still checked and available updates are logged, but never installed.
#NPU_EXCLUDE=
